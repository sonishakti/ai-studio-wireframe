{
  "id": "P0.15",
  "title": "Retire an agent",
  "name": "P0.15 \u00b7 Retire an agent",
  "jtbd": {
    "job": "Sam retires an agent without leaving a number or run pointing at nothing.",
    "situation": "The builder has no delete at all; DELETE /agents/{id} exists in the v3 API with no undo, and nothing says whether the server refuses it while a number or run references the agent.",
    "wantsTo": "see everything that still uses it, move or stop each thing, and then delete it on purpose",
    "soThat": "no caller reaches a dead number and no run dials with a missing agent",
    "happySteps": [
      "Sam chooses Delete on the agent.",
      "A confirm lists every number and run that uses the agent, with a door to re-point or stop each.",
      "Sam re-points the number to another agent and cancels the run.",
      "Sam types the agent name and deletes. Its sessions and error groups stay in history, tagged Agent deleted (P1.4.g, P2.1.b)."
    ],
    "rainyTitles": [
      {
        "id": ".b",
        "title": "A number still points at the agent"
      },
      {
        "id": ".c",
        "title": "A scheduled or running run uses the agent"
      },
      {
        "id": ".d",
        "title": "The agent's secret sets are used by no other agent"
      },
      {
        "id": ".e",
        "title": "The team's own code still starts sessions with this agent"
      },
      {
        "id": ".f",
        "title": "Sam deletes by mistake"
      }
    ]
  },
